<?php

class Config{

	private static $config = null;
	public $sitename = 'Disco nunu';
	public $subTitle = 'Simple CMS for blogs';
	public $salt = '$KMGg4QdfF'; 
	public $folder = ''; // local dev: servi à la racine via php -S (2026-09-15)
	public $servername = "localhost";
	public $dbusername = "root";
	public $dbpassword = "";
	public $dbname = "disconunu";
	public $mod_rewrite = false; // local dev: php -S ne gère pas .htaccess


	private function __construct(){
		
	}


	public static function getConfig(){

		if(is_null(self::$config))
			self::$config = new Config();

	return self::$config;

	}


	public function getSiteURL(){

		$port = isset($_SERVER['SERVER_PORT']) && $_SERVER['SERVER_PORT'] != 80 ? ':' . $_SERVER['SERVER_PORT'] : '';
		return "http://" . $_SERVER['SERVER_NAME'] . $port . '/' . $this->folder;

	}
}

$config = Config::getConfig();
?>
